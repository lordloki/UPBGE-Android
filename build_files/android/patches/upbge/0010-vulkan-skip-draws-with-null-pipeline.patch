diff --git a/source/blender/gpu/vulkan/render_graph/nodes/vk_draw_indexed_indirect_node.hh b/source/blender/gpu/vulkan/render_graph/nodes/vk_draw_indexed_indirect_node.hh
index 15c7054..91f08c4 100644
--- a/source/blender/gpu/vulkan/render_graph/nodes/vk_draw_indexed_indirect_node.hh
+++ b/source/blender/gpu/vulkan/render_graph/nodes/vk_draw_indexed_indirect_node.hh
@@ -93,6 +93,14 @@ class VKDrawIndexedIndirectNode
                       Span<uint8_t> storage_push_constants,
                       VKBoundPipelines &r_bound_pipelines) override
   {
+    /* UPBGE - Android: VKPipelinePool ignores the vkCreateGraphicsPipelines result, so a
+     * pipeline the driver failed to compile is VK_NULL_HANDLE (Mali r49: EEVEE deferred light).
+     * Binding it crashes the driver. Drop the draw; bound state is left untouched so the
+     * cached state tracking stays in sync with the command buffer. */
+    if (data.graphics.pipeline_data.vk_pipeline == VK_NULL_HANDLE) {
+      return;
+    }
+    /* UPBGE - Android */
     vk_pipeline_dynamic_graphics_build_commands(command_buffer, data.graphics, r_bound_pipelines);
     vk_pipeline_data_build_commands(command_buffer,
                                     data.graphics.pipeline_data,
