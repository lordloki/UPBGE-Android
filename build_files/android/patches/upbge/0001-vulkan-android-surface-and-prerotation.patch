--- /dev/null
+++ b/source/blender/gpu/vulkan/shaders/vk_backbuffer_rotate_infos.hh
@@ -0,0 +1,22 @@
+/* SPDX-FileCopyrightText: 2026 UPBGE Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* UPBGE - Android: back buffer -> pre-rotated swapchain copy. */
+
+#ifdef GPU_SHADER
+#  pragma once
+#endif
+
+#include "gpu_shader_create_info.hh"
+
+GPU_SHADER_CREATE_INFO(vk_backbuffer_rotate)
+LOCAL_GROUP_SIZE(16, 16)
+IMAGE(0, UNORM_8_8_8_8, read, Float2D, src_img)
+IMAGE(1, UNORM_8_8_8_8, write, Float2D, dst_img)
+/* 0 = identity, 1 = rotate 90, 2 = rotate 180, 3 = rotate 270 (clockwise, as in
+ * VkSurfaceTransformFlagBitsKHR). */
+PUSH_CONSTANT(int, rotation)
+COMPUTE_SOURCE("vk_backbuffer_rotate_comp.glsl")
+DO_STATIC_COMPILATION()
+GPU_SHADER_CREATE_END()
