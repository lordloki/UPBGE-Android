+++ b/source/blender/gpu/vulkan/shaders/vk_backbuffer_rotate_comp.glsl
@@ -0,0 +1,45 @@
+/* SPDX-FileCopyrightText: 2026 UPBGE Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* UPBGE - Android: copy the back buffer into a swapchain image that lives in the display's
+ * identity orientation, applying the surface transform the swapchain was created with.
+ *
+ * Image rows are top-down on screen. The back buffer is bottom-up (GL convention), which is why
+ * the identity case flips Y exactly like the regular blit. Composing that flip with a clockwise
+ * rotation of the W x H logical frame `L` gives, for a destination texel `d`:
+ *   identity: L(d.x,         d.y)         = src(d.x,         H - 1 - d.y)
+ *   rot 90:   L(d.y,         H - 1 - d.x) = src(d.y,         d.x)
+ *   rot 180:  L(W - 1 - d.x, H - 1 - d.y) = src(W - 1 - d.x, d.y)
+ *   rot 270:  L(W - 1 - d.y, d.x)         = src(W - 1 - d.y, H - 1 - d.x)
+ * `rotation` is uniform across the dispatch, so the switch is a uniform branch. 16x16 groups
+ * keep the transposed reads of the 90/270 cases inside one 16x16 source tile. */
+
+#include "vk_backbuffer_rotate_infos.hh"
+
+COMPUTE_SHADER_CREATE_INFO(vk_backbuffer_rotate)
+
+void main()
+{
+  int2 d = int2(gl_GlobalInvocationID.xy);
+  if (any(greaterThanEqual(d, int2(imageSize(dst_img))))) {
+    return;
+  }
+  int2 s = int2(imageSize(src_img));
+  int2 src_texel;
+  switch (rotation) {
+    case 1:
+      src_texel = int2(d.y, d.x);
+      break;
+    case 2:
+      src_texel = int2(s.x - 1 - d.x, d.y);
+      break;
+    case 3:
+      src_texel = int2(s.x - 1 - d.y, s.y - 1 - d.x);
+      break;
+    default:
+      src_texel = int2(d.x, s.y - 1 - d.y);
+      break;
+  }
+  imageStore(dst_img, d, imageLoad(src_img, src_texel));
+}
diff --git a/source/blender/gpu/vulkan/shaders/vk_backbuffer_rotate_infos.hh b/source/blender/gpu/vulkan/shaders/vk_backbuffer_rotate_infos.hh
