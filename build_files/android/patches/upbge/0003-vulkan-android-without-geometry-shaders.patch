+#ifdef __ANDROID__
+  GCaps.geometry_shader_support = device.physical_device_features_get().geometryShader;
+  if (!GCaps.geometry_shader_support) {
+    const VKExtensions &extensions = device.extensions_get();
+    if (!extensions.shader_viewport_index_layer) {
+      GCaps.multi_viewport_support = false;
+    }
+    GCaps.shader_barycentric_support = extensions.fragment_shader_barycentric;
+  }
+#endif
+  /* UPBGE - Android */
+
   device.resources.use_dynamic_rendering_local_read =
       device.extensions_get().dynamic_rendering_local_read;
 }
