@@ -951,6 +953,24 @@ void VKBackend::capabilities_init(VKDevice &device)
 
   detect_workarounds(device);
 
+  /* UPBGE - Android: no geometry shaders (Mali). No shipped shader has a geometry stage; the
+   * backend only injects one to emulate a missing extension. Avoid those cases instead:
+   * - viewport index output (EEVEE shadows): disable multi-viewport, EEVEE then renders every
+   *   shadow tile into the largest viewport (more fragment work, same result);
+   * - barycentric coordinates (Wireframe node, Geometry > Parametric): EEVEE compiles those
