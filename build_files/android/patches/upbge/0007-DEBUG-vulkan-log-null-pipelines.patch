@@ -21,6 +21,24 @@
 #include "vk_graphics_pipeline.hh"
 #include "vk_pipeline_pool.hh"
 
+/* TEMPORARY DEBUG (Android bring-up): vkCreate*Pipelines results are ignored,
+ * so a failed creation binds VK_NULL_HANDLE later. Log name and VkResult. */
+#ifdef __ANDROID__
+#  include <android/log.h>
+#  define UPBGE_DBG_PIPELINE(pipeline, name, result) \
+    if ((pipeline) == VK_NULL_HANDLE || (result) != VK_SUCCESS) { \
+      __android_log_print(ANDROID_LOG_ERROR, \
+                          "UPBGE", \
+                          "pipeline '%s': VkResult %d, handle %s (GPL %s)", \
+                          (name).c_str(), \
+                          int(result), \
+                          (pipeline) == VK_NULL_HANDLE ? "NULL" : "valid", \
+                          VKBackend::get().device.extensions_get().graphics_pipeline_library ? "on" : "off"); \
+    }
+#else
+#  define UPBGE_DBG_PIPELINE(pipeline, name, result) (void)(result)
+#endif
+
