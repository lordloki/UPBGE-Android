+static uint64_t monotonic_ms()
+{
+  timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return uint64_t(ts.tv_sec) * 1000u + uint64_t(ts.tv_nsec) / 1000000u;
+}
+
+void GPG_SystemAndroid::setAndroidApp(android_app *app)
+{
+  g_android_app = app;
+}
+
+android_app *GPG_SystemAndroid::getAndroidApp()
+{
+  return g_android_app;
+}
+
+GHOST_TSuccess GPG_SystemAndroid::create()
+{
+  if (system_ != nullptr || g_android_app == nullptr) {
+    return GHOST_kFailure;
+  }
+  GPG_SystemAndroid *system = new GPG_SystemAndroid(g_android_app);
+  if (system->init() == GHOST_kFailure) {
+    delete system;
+    return GHOST_kFailure;
+  }
+  system_ = system;
+  system_backend_id_ = "ANDROID";
+  return GHOST_kSuccess;
+}
+
+GPG_SystemAndroid::GPG_SystemAndroid(android_app *app) : app_(app), start_ms_(monotonic_ms())
+{
+  app_->userData = this;
+  app_->onAppCmd = &GPG_SystemAndroid::onAppCmd;
+  app_->onInputEvent = &GPG_SystemAndroid::onInputEvent;
+}
+
+GPG_SystemAndroid::~GPG_SystemAndroid()
+{
+  /* android_main() keeps draining the looper after the game ends; the callbacks must not see
+   * a dead system. */
+  app_->onAppCmd = nullptr;
+  app_->onInputEvent = nullptr;
+  app_->userData = nullptr;
+}
+
+void GPG_SystemAndroid::windowDestroyed(GPG_WindowAndroid *window)
+{
+  if (window_ == window) {
+    window_ = nullptr;
+  }
+}
+
+/* -------------------------------------------------------------------- */
+/** \name Events
+ * \{ */
+
+bool GPG_SystemAndroid::processEvents(bool waitForEvent)
+{
+  bool any_processed = false;
+
+  int timeout_ms = 0;
+  if (waitForEvent) {
+    const uint64_t next = timer_manager_->nextFireTime();
+    if (next == GHOST_kFireTimeNever) {
+      timeout_ms = -1;
+    }
+    else {
+      const uint64_t now = getMilliSeconds();
+      timeout_ms = (next > now) ? int(next - now) : 0;
+    }
+  }
+
+  /* Drain everything queued now; only the first poll may block. The glue dispatches through
+   * android_poll_source::process, which ends in onAppCmd()/onInputEvent(). */
+  for (;;) {
+    int events;
+    android_poll_source *source = nullptr;
+    const int id = ALooper_pollOnce(timeout_ms, nullptr, &events, (void **)&source);
+    if (id == ALOOPER_POLL_TIMEOUT || id == ALOOPER_POLL_ERROR || id == ALOOPER_POLL_WAKE) {
+      break;
+    }
+    if (id >= 0 && source != nullptr) {
+      source->process(app_, source);
+      any_processed = true;
+    }
+    timeout_ms = 0;
+  }
+
+  if (timer_manager_->fireTimers(getMilliSeconds())) {
+    any_processed = true;
+  }
+  return any_processed;
+}
+
+void GPG_SystemAndroid::onAppCmd(android_app *app, int32_t cmd)
+{
+  GPG_SystemAndroid *system = static_cast<GPG_SystemAndroid *>(app->userData);
+  if (system == nullptr) {
+    return;
+  }
+  GPG_WindowAndroid *window = system->window_;
+
+  switch (cmd) {
+    case APP_CMD_TERM_WINDOW:
+      /* The glue blocks the UI thread until this returns, then lets the surface die. Stop
+       * presenting before that and end the game (lifecycle v1). */
+      if (window) {
+        window->markLost();
+      }
+      system->pushEvent(std::make_unique<GHOST_Event>(
+          system->getMilliSeconds(), GHOST_kEventQuitRequest, window));
+      break;
+    case APP_CMD_DESTROY:
+      system->pushEvent(std::make_unique<GHOST_Event>(
+          system->getMilliSeconds(), GHOST_kEventQuitRequest, window));
+      break;
+    case APP_CMD_WINDOW_RESIZED:
+    case APP_CMD_CONFIG_CHANGED:
+    case APP_CMD_CONTENT_RECT_CHANGED:
+      if (window && window->updateSize()) {
+        system->pushEvent(std::make_unique<GHOST_Event>(
+            system->getMilliSeconds(), GHOST_kEventWindowSize, window));
+      }
+      break;
+    case APP_CMD_GAINED_FOCUS:
+      if (window) {
+        system->pushEvent(std::make_unique<GHOST_Event>(
+            system->getMilliSeconds(), GHOST_kEventWindowActivate, window));
+      }
+      break;
+    case APP_CMD_LOST_FOCUS:
+      if (window) {
+        system->pushEvent(std::make_unique<GHOST_Event>(
+            system->getMilliSeconds(), GHOST_kEventWindowDeactivate, window));
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+int32_t GPG_SystemAndroid::onInputEvent(android_app *app, AInputEvent *event)
+{
+  GPG_SystemAndroid *system = static_cast<GPG_SystemAndroid *>(app->userData);
+  if (system == nullptr || system->window_ == nullptr) {
+    return 0;
+  }
+  switch (AInputEvent_getType(event)) {
+    case AINPUT_EVENT_TYPE_MOTION:
+      return system->handleMotion(event);
+    case AINPUT_EVENT_TYPE_KEY:
+      return system->handleKey(event);
+    default:
+      return 0;
+  }
+}
+
+void GPG_SystemAndroid::pushCursor(int32_t x, int32_t y)
+{
+  if (x == cursor_x_ && y == cursor_y_) {
+    return;
+  }
+  cursor_x_ = x;
+  cursor_y_ = y;
+  pushEvent(std::make_unique<GHOST_EventCursor>(
+      getMilliSeconds(), GHOST_kEventCursorMove, window_, x, y, GHOST_TABLET_DATA_NONE));
+}
+
+void GPG_SystemAndroid::pushButton(bool down)
+{
+  if (down == left_down_) {
+    return;
+  }
+  left_down_ = down;
+  pushEvent(std::make_unique<GHOST_EventButton>(getMilliSeconds(),
+                                                down ? GHOST_kEventButtonDown :
+                                                       GHOST_kEventButtonUp,
+                                                window_,
+                                                GHOST_kButtonMaskLeft,
+                                                GHOST_TABLET_DATA_NONE));
+}
+
+int32_t GPG_SystemAndroid::handleMotion(const AInputEvent *event)
+{
+  /* v1: the first finger is the mouse (left button). Further fingers are ignored. Only the
+   * newest sample is used: the engine reads input once per frame, historical samples would
+   * only add events. */
+  const int32_t action = AMotionEvent_getAction(event);
+  const int32_t masked = action & AMOTION_EVENT_ACTION_MASK;
+  const size_t action_index = size_t((action & AMOTION_EVENT_ACTION_POINTER_INDEX_MASK) >>
+                                     AMOTION_EVENT_ACTION_POINTER_INDEX_SHIFT);
+
+  switch (masked) {
+    case AMOTION_EVENT_ACTION_DOWN:
+      touch_id_ = AMotionEvent_getPointerId(event, 0);
+      pushCursor(int32_t(AMotionEvent_getX(event, 0)), int32_t(AMotionEvent_getY(event, 0)));
+      pushButton(true);
+      return 1;
+    case AMOTION_EVENT_ACTION_MOVE:
+    case AMOTION_EVENT_ACTION_HOVER_MOVE: {
+      const size_t count = AMotionEvent_getPointerCount(event);
+      for (size_t i = 0; i < count; i++) {
+        if (touch_id_ < 0 || AMotionEvent_getPointerId(event, i) == touch_id_) {
+          pushCursor(int32_t(AMotionEvent_getX(event, i)), int32_t(AMotionEvent_getY(event, i)));
+          break;
+        }
+      }
+      return 1;
+    }
+    case AMOTION_EVENT_ACTION_POINTER_UP:
+      if (AMotionEvent_getPointerId(event, action_index) != touch_id_) {
+        return 1;
+      }
+      [[fallthrough]];
+    case AMOTION_EVENT_ACTION_UP:
+    case AMOTION_EVENT_ACTION_CANCEL:
+      if (masked != AMOTION_EVENT_ACTION_CANCEL) {
+        pushCursor(int32_t(AMotionEvent_getX(event, action_index)),
+                   int32_t(AMotionEvent_getY(event, action_index)));
+      }
+      pushButton(false);
+      touch_id_ = -1;
+      return 1;
+    default:
+      return 0;
+  }
+}
+
+static GHOST_TKey convert_key(int32_t code)
+{
+  if (code >= AKEYCODE_A && code <= AKEYCODE_Z) {
+    return GHOST_TKey(GHOST_kKeyA + (code - AKEYCODE_A));
+  }
+  if (code >= AKEYCODE_0 && code <= AKEYCODE_9) {
+    return GHOST_TKey(GHOST_kKey0 + (code - AKEYCODE_0));
+  }
+  if (code >= AKEYCODE_F1 && code <= AKEYCODE_F12) {
+    return GHOST_TKey(GHOST_kKeyF1 + (code - AKEYCODE_F1));
+  }
+  if (code >= AKEYCODE_NUMPAD_0 && code <= AKEYCODE_NUMPAD_9) {
+    return GHOST_TKey(GHOST_kKeyNumpad0 + (code - AKEYCODE_NUMPAD_0));
+  }
+  switch (code) {
+    /* Back is the game's exit key (Esc by default). */
+    case AKEYCODE_BACK:
+    case AKEYCODE_ESCAPE:
+      return GHOST_kKeyEsc;
+    case AKEYCODE_ENTER:
+    case AKEYCODE_DPAD_CENTER:
+      return GHOST_kKeyEnter;
+    case AKEYCODE_SPACE:
+      return GHOST_kKeySpace;
+    case AKEYCODE_DEL:
+      return GHOST_kKeyBackSpace;
+    case AKEYCODE_FORWARD_DEL:
+      return GHOST_kKeyDelete;
+    case AKEYCODE_TAB:
+      return GHOST_kKeyTab;
+    case AKEYCODE_DPAD_UP:
+      return GHOST_kKeyUpArrow;
+    case AKEYCODE_DPAD_DOWN:
+      return GHOST_kKeyDownArrow;
+    case AKEYCODE_DPAD_LEFT:
+      return GHOST_kKeyLeftArrow;
+    case AKEYCODE_DPAD_RIGHT:
+      return GHOST_kKeyRightArrow;
+    case AKEYCODE_SHIFT_LEFT:
+      return GHOST_kKeyLeftShift;
+    case AKEYCODE_SHIFT_RIGHT:
+      return GHOST_kKeyRightShift;
+    case AKEYCODE_CTRL_LEFT:
+      return GHOST_kKeyLeftControl;
+    case AKEYCODE_CTRL_RIGHT:
+      return GHOST_kKeyRightControl;
+    case AKEYCODE_ALT_LEFT:
+      return GHOST_kKeyLeftAlt;
+    case AKEYCODE_ALT_RIGHT:
+      return GHOST_kKeyRightAlt;
+    case AKEYCODE_CAPS_LOCK:
+      return GHOST_kKeyCapsLock;
+    case AKEYCODE_MOVE_HOME:
+      return GHOST_kKeyHome;
+    case AKEYCODE_MOVE_END:
+      return GHOST_kKeyEnd;
+    case AKEYCODE_PAGE_UP:
+      return GHOST_kKeyUpPage;
+    case AKEYCODE_PAGE_DOWN:
+      return GHOST_kKeyDownPage;
+    case AKEYCODE_INSERT:
+      return GHOST_kKeyInsert;
+    case AKEYCODE_MINUS:
+      return GHOST_kKeyMinus;
+    case AKEYCODE_EQUALS:
+      return GHOST_kKeyEqual;
+    case AKEYCODE_COMMA:
+      return GHOST_kKeyComma;
+    case AKEYCODE_PERIOD:
+      return GHOST_kKeyPeriod;
+    case AKEYCODE_SLASH:
+      return GHOST_kKeySlash;
+    case AKEYCODE_SEMICOLON:
+      return GHOST_kKeySemicolon;
+    case AKEYCODE_APOSTROPHE:
+      return GHOST_kKeyQuote;
+    case AKEYCODE_LEFT_BRACKET:
+      return GHOST_kKeyLeftBracket;
+    case AKEYCODE_RIGHT_BRACKET:
+      return GHOST_kKeyRightBracket;
+    case AKEYCODE_BACKSLASH:
+      return GHOST_kKeyBackslash;
+    case AKEYCODE_GRAVE:
+      return GHOST_kKeyAccentGrave;
+    case AKEYCODE_NUMPAD_DOT:
+      return GHOST_kKeyNumpadPeriod;
+    case AKEYCODE_NUMPAD_ENTER:
+      return GHOST_kKeyNumpadEnter;
+    case AKEYCODE_NUMPAD_ADD:
+      return GHOST_kKeyNumpadPlus;
+    case AKEYCODE_NUMPAD_SUBTRACT:
+      return GHOST_kKeyNumpadMinus;
+    case AKEYCODE_NUMPAD_MULTIPLY:
+      return GHOST_kKeyNumpadAsterisk;
+    case AKEYCODE_NUMPAD_DIVIDE:
+      return GHOST_kKeyNumpadSlash;
+    default:
+      return GHOST_kKeyUnknown;
+  }
+}
+
+int32_t GPG_SystemAndroid::handleKey(const AInputEvent *event)
+{
+  const int32_t action = AKeyEvent_getAction(event);
+  if (action != AKEY_EVENT_ACTION_DOWN && action != AKEY_EVENT_ACTION_UP) {
+    return 0;
+  }
+  const GHOST_TKey key = convert_key(AKeyEvent_getKeyCode(event));
+  if (key == GHOST_kKeyUnknown) {
+    /* Not ours (volume, power, media...): let Android handle it. */
+    return 0;
+  }
+  const bool down = (action == AKEY_EVENT_ACTION_DOWN);
+  switch (key) {
+    case GHOST_kKeyLeftShift:
+      modifiers_.set(GHOST_kModifierKeyLeftShift, down);
+      break;
+    case GHOST_kKeyRightShift:
+      modifiers_.set(GHOST_kModifierKeyRightShift, down);
+      break;
+    case GHOST_kKeyLeftControl:
+      modifiers_.set(GHOST_kModifierKeyLeftControl, down);
+      break;
+    case GHOST_kKeyRightControl:
+      modifiers_.set(GHOST_kModifierKeyRightControl, down);
+      break;
+    case GHOST_kKeyLeftAlt:
+      modifiers_.set(GHOST_kModifierKeyLeftAlt, down);
+      break;
+    case GHOST_kKeyRightAlt:
+      modifiers_.set(GHOST_kModifierKeyRightAlt, down);
+      break;
+    default:
+      break;
+  }
+  /* No text: the NDK key event carries no Unicode (that needs KeyCharacterMap over JNI). */
+  pushEvent(std::make_unique<GHOST_EventKey>(getMilliSeconds(),
+                                             down ? GHOST_kEventKeyDown : GHOST_kEventKeyUp,
+                                             window_,
+                                             key,
+                                             AKeyEvent_getRepeatCount(event) > 0));
+  return 1;
+}
