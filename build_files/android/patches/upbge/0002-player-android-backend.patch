+
+GHOST_TSuccess GPG_SystemAndroid::getModifierKeys(GHOST_ModifierKeys &keys) const
+{
+  keys = modifiers_;
+  return GHOST_kSuccess;
+}
+
+GHOST_TSuccess GPG_SystemAndroid::getButtons(GHOST_Buttons &buttons) const
+{
+  buttons.set(GHOST_kButtonMaskLeft, left_down_);
+  return GHOST_kSuccess;
+}
+
+GHOST_TCapabilityFlag GPG_SystemAndroid::getCapabilities() const
+{
+  /* Back buffer and front buffer are the same texture in the Vulkan backend. Nothing else:
+   * no window placement, cursor warp, clipboard, IME or decorations. */
+  return GHOST_kCapabilityGPUReadFrontBuffer;
+}
+
+uint64_t GPG_SystemAndroid::getMilliSeconds() const
+{
+  return monotonic_ms() - start_ms_;
+}
+
+GHOST_TSuccess GPG_SystemAndroid::getCursorPosition(int32_t &x, int32_t &y) const
+{
+  x = cursor_x_;
+  y = cursor_y_;
+  return GHOST_kSuccess;
+}
+
+GHOST_TSuccess GPG_SystemAndroid::setCursorPosition(int32_t x, int32_t y)
+{
+  /* No pointer to warp. Keep the value so get/set pairs (mouse look) stay consistent. */
+  cursor_x_ = x;
+  cursor_y_ = y;
+  return GHOST_kSuccess;
+}
+
+void GPG_SystemAndroid::getMainDisplayDimensions(uint32_t &width, uint32_t &height) const
+{
+  if (window_) {
+    GHOST_Rect bounds;
+    window_->getClientBounds(bounds);
+    width = uint32_t(bounds.getWidth());
+    height = uint32_t(bounds.getHeight());
+  }
+  else if (app_->window) {
+    width = uint32_t(ANativeWindow_getWidth(app_->window));
+    height = uint32_t(ANativeWindow_getHeight(app_->window));
+  }
+  else {
+    width = height = 0;
+  }
+}
+
+void GPG_SystemAndroid::getAllDisplayDimensions(uint32_t &width, uint32_t &height) const
+{
+  getMainDisplayDimensions(width, height);
+}
