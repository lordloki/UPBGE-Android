+/* SPDX-FileCopyrightText: 2026 UPBGE Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file GPG_WindowAndroid.h
+ *  \ingroup player
+ *
+ * The activity's ANativeWindow as a GHOST window. Size is owned by Android (always full
+ * screen); it is cached and refreshed only on the glue's resize/config commands, so per-frame
+ * size queries are a load instead of a call into libnativewindow.
+ */
+
+#pragma once
+
+#include "GHOST_Window.hh"
+
+struct ANativeWindow;
+class GPG_SystemAndroid;
+
+class GPG_WindowAndroid : public GHOST_Window {
+ public:
+  GPG_WindowAndroid(GPG_SystemAndroid *system,
+                    ANativeWindow *native_window,
+                    GHOST_TWindowState state,
+                    const GHOST_GPUSettings &gpu_settings);
+  ~GPG_WindowAndroid() override;
+
+  /** The surface is going away: from now on no swap touches it. */
+  void markLost()
+  {
+    lost_ = true;
+  }
+  bool isLost() const
+  {
+    return lost_;
+  }
+  /** Re-read the native window size. Returns true when it changed. */
+  bool updateSize();
+
+  bool getValid() const override;
+  void setTitle(const char * /*title*/) override {}
+  std::string getTitle() const override
+  {
+    return "UPBGE";
+  }
+  void setPath(const char * /*filepath*/) override {}
+  void getWindowBounds(GHOST_Rect &bounds) const override;
+  void getClientBounds(GHOST_Rect &bounds) const override;
+  GHOST_TSuccess setClientWidth(uint32_t /*width*/) override
+  {
+    return GHOST_kFailure;
+  }
+  GHOST_TSuccess setClientHeight(uint32_t /*height*/) override
+  {
+    return GHOST_kFailure;
+  }
+  GHOST_TSuccess setClientSize(uint32_t /*width*/, uint32_t /*height*/) override
+  {
+    return GHOST_kFailure;
+  }
+  void screenToClient(int32_t inX, int32_t inY, int32_t &outX, int32_t &outY) const override
+  {
+    outX = inX;
+    outY = inY;
+  }
+  void clientToScreen(int32_t inX, int32_t inY, int32_t &outX, int32_t &outY) const override
+  {
+    outX = inX;
+    outY = inY;
+  }
+  GHOST_TWindowState getState() const override
+  {
+    return GHOST_kWindowStateFullScreen;
+  }
+  GHOST_TSuccess setState(GHOST_TWindowState /*state*/) override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess setOrder(GHOST_TWindowOrder /*order*/) override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess invalidate() override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess beginFullScreen() const override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess endFullScreen() const override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess hasCursorShape(GHOST_TStandardCursor /*cursor_shape*/) override
+  {
+    return GHOST_kFailure;
+  }
+
+  /* A lost surface must not be acquired nor presented; the frames rendered until the quit
+   * request is handled only touch the back buffer. */
+  GHOST_TSuccess swapBufferAcquire() override;
+  GHOST_TSuccess swapBufferRelease() override;
+
+ protected:
+  GHOST_TSuccess setWindowCursorGrab(GHOST_TGrabCursorMode /*mode*/) override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess setWindowCursorShape(GHOST_TStandardCursor /*shape*/) override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess setWindowCustomCursorShape(const uint8_t * /*bitmap*/,
+                                            const uint8_t * /*mask*/,
+                                            const int /*size*/[2],
+                                            const int /*hot_spot*/[2],
+                                            bool /*can_invert_color*/) override
+  {
+    return GHOST_kSuccess;
+  }
+  GHOST_TSuccess setWindowCursorVisibility(bool /*visible*/) override
+  {
+    return GHOST_kSuccess;
+  }
+
+ private:
+  GHOST_Context *newDrawingContext(GHOST_TDrawingContextType type) override;
+
+  GPG_SystemAndroid *system_;
+  ANativeWindow *native_window_;
+  GHOST_GPUDevice preferred_device_;
+  int32_t width_;
+  int32_t height_;
+  bool valid_ = false;
+  bool lost_ = false;
+};
diff --git a/source/gameengine/GamePlayer/android/GPG_android_main.cpp b/source/gameengine/GamePlayer/android/GPG_android_main.cpp
new file mode 100644
index 00000000..6da20c4b
--- /dev/null
+++ b/source/gameengine/GamePlayer/android/GPG_android_main.cpp
@@ -0,0 +1,353 @@
+/* SPDX-FileCopyrightText: 2026 UPBGE Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file GPG_android_main.cpp
+ *  \ingroup player
+ *
+ * NativeActivity entry point (android_native_app_glue calls android_main() on its own thread).
+ *
+ * Blender needs real files: the resources tree (scripts, datafiles, Python stdlib) and the
+ * game are copied from the APK assets into internal storage on first launch, and again only
+ * when the packaged manifest changes. Then GPG_main() runs the regular player with
+ * `-w <game.blend>`.
+ */
+
+#include "GPG_SystemAndroid.h"
+
+#include <android/asset_manager.h>
+#include <android/log.h>
+#include <android/looper.h>
+#include <android/native_activity.h>
+#include <android_native_app_glue.h>
+
+#include <cctype>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <pthread.h>
+#include <string>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+
+/* GPG_ghost.cpp: main() of the desktop player, renamed on Android. */
+extern int GPG_main(int argc, char **argv);
+
+static const char *LOG_TAG = "UPBGE";
+/* Packaged by scripts/package_player.sh: a build stamp line, then one asset path per line. */
+static const char *MANIFEST_ASSET = "upbge/files.txt";
+
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, LOG_TAG, __VA_ARGS__)
+#define LOGE(...) __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, __VA_ARGS__)
+
+/* -------------------------------------------------------------------- */
+/** \name stdout/stderr to logcat
+ *
+ * Android discards fd 1/2. Every CM_Message, printf and Python print would be lost. One
+ * blocked reader thread costs nothing while idle.
+ * \{ */
+
+static int g_log_pipe[2] = {-1, -1};
+static pthread_t g_log_thread;
+static bool g_log_thread_running = false;
+
+static void *log_thread_main(void * /*arg*/)
+{
+  char buf[1024];
+  size_t len = 0;
+  for (;;) {
+    const ssize_t n = read(g_log_pipe[0], buf + len, sizeof(buf) - 1 - len);
+    if (n <= 0) {
+      break;
+    }
+    len += size_t(n);
+    char *start = buf;
+    char *newline;
+    while ((newline = static_cast<char *>(memchr(start, '\n', len - size_t(start - buf))))) {
+      *newline = '\0';
+      __android_log_write(ANDROID_LOG_INFO, LOG_TAG, start);
+      start = newline + 1;
+    }
+    len -= size_t(start - buf);
+    if (len == sizeof(buf) - 1) {
+      /* A line longer than the buffer: emit what we have. */
+      buf[len] = '\0';
+      __android_log_write(ANDROID_LOG_INFO, LOG_TAG, buf);
+      len = 0;
+    }
+    else if (start != buf) {
+      memmove(buf, start, len);
+    }
+  }
+  return nullptr;
+}
+
+static void redirect_stdio_to_logcat()
+{
+  setvbuf(stdout, nullptr, _IOLBF, 0);
+  setvbuf(stderr, nullptr, _IONBF, 0);
+  if (pipe(g_log_pipe) != 0) {
+    return;
+  }
+  dup2(g_log_pipe[1], STDOUT_FILENO);
+  dup2(g_log_pipe[1], STDERR_FILENO);
+  g_log_thread_running = (pthread_create(&g_log_thread, nullptr, log_thread_main, nullptr) == 0);
+}
+
+/* The reader runs behind the writers: drain it, or the last lines (often the error that
+ * ended the game) die with the process. Closing every write end makes read() return 0. */
+static void flush_stdio_to_logcat()
+{
+  fflush(stdout);
+  fflush(stderr);
+  if (!g_log_thread_running) {
+    return;
+  }
+  close(STDOUT_FILENO);
+  close(STDERR_FILENO);
+  close(g_log_pipe[1]);
+  pthread_join(g_log_thread, nullptr);
+  g_log_thread_running = false;
+}
+
+/** \} */
+
+/* -------------------------------------------------------------------- */
+/** \name Looper helpers
+ * \{ */
+
+/* Run pending glue commands without blocking. Lifecycle commands block the UI thread until
+ * this thread handles them, so long work (asset copy) calls this between steps. */
+static void drain_looper(android_app *app, int timeout_ms)
+{
+  for (;;) {
+    int events;
+    android_poll_source *source = nullptr;
+    const int id = ALooper_pollOnce(timeout_ms, nullptr, &events, (void **)&source);
+    if (id == ALOOPER_POLL_TIMEOUT || id == ALOOPER_POLL_ERROR || id == ALOOPER_POLL_WAKE) {
+      return;
+    }
+    if (id >= 0 && source != nullptr) {
+      source->process(app, source);
+    }
+    timeout_ms = 0;
+  }
+}
+
+static bool wait_for_window(android_app *app)
+{
+  while (app->window == nullptr) {
+    if (app->destroyRequested) {
+      return false;
+    }
+    drain_looper(app, -1);
+  }
+  return !app->destroyRequested;
+}
+
+/** \} */
+
+/* -------------------------------------------------------------------- */
+/** \name Asset extraction
+ * \{ */
+
+static bool read_asset(AAssetManager *manager, const char *name, std::string &r_data)
+{
+  AAsset *asset = AAssetManager_open(manager, name, AASSET_MODE_BUFFER);
+  if (asset == nullptr) {
+    return false;
+  }
+  const off_t size = AAsset_getLength(asset);
+  r_data.resize(size_t(size));
+  const bool ok = (size == 0) || (AAsset_read(asset, r_data.data(), size_t(size)) == size);
+  AAsset_close(asset);
+  return ok;
+}
+
+static bool read_file(const std::string &path, std::string &r_data)
+{
+  FILE *file = fopen(path.c_str(), "rb");
+  if (file == nullptr) {
+    return false;
+  }
+  r_data.clear();
+  char buf[4096];
+  size_t n;
+  while ((n = fread(buf, 1, sizeof(buf), file)) > 0) {
+    r_data.append(buf, n);
+  }
+  fclose(file);
+  return true;
+}
+
+static void make_parent_dirs(const std::string &path)
+{
+  for (size_t i = 1; i < path.size(); i++) {
+    if (path[i] == '/') {
+      const std::string dir = path.substr(0, i);
+      mkdir(dir.c_str(), 0700);
+    }
+  }
+}
+
+static bool copy_asset(AAssetManager *manager,
+                       const char *name,
+                       const std::string &dst,
+                       char *buf,
+                       size_t buf_size)
+{
+  AAsset *asset = AAssetManager_open(manager, name, AASSET_MODE_STREAMING);
+  if (asset == nullptr) {
+    LOGE("missing asset: %s", name);
+    return false;
+  }
+  make_parent_dirs(dst);
+  /* Write next to the target and rename: a kill mid-copy never leaves a truncated file that
+   * a later launch would trust. */
+  const std::string tmp = dst + ".part";
+  FILE *file = fopen(tmp.c_str(), "wb");
+  bool ok = (file != nullptr);
+  int n = 0;
+  while (ok && (n = AAsset_read(asset, buf, buf_size)) > 0) {
+    ok = (fwrite(buf, 1, size_t(n), file) == size_t(n));
+  }
+  ok = ok && (n == 0);
+  if (file) {
+    ok = (fclose(file) == 0) && ok;
+  }
+  AAsset_close(asset);
+  ok = ok && (rename(tmp.c_str(), dst.c_str()) == 0);
+  if (!ok) {
+    LOGE("failed to extract %s: %s", name, strerror(errno));
+    unlink(tmp.c_str());
+  }
+  return ok;
+}
+
+static bool extract_assets(android_app *app, const std::string &root)
+{
+  AAssetManager *manager = app->activity->assetManager;
+  std::string manifest;
+  if (!read_asset(manager, MANIFEST_ASSET, manifest)) {
+    LOGE("missing asset manifest %s", MANIFEST_ASSET);
+    return false;
+  }
+  const std::string stamp_path = root + "/files.txt";
+  std::string installed;
+  if (read_file(stamp_path, installed) && installed == manifest) {
+    return true;
+  }
+
+  LOGI("extracting assets to %s", root.c_str());
+  /* Invalidate first: an interrupted extraction must be redone on the next launch. */
+  unlink(stamp_path.c_str());
+
+  const size_t buf_size = 256 * 1024;
+  char *buf = static_cast<char *>(malloc(buf_size));
+  bool ok = (buf != nullptr);
+  size_t line_begin = manifest.find('\n');
+  /* First line is the build stamp. */
+  line_begin = (line_begin == std::string::npos) ? manifest.size() : line_begin + 1;
+  while (ok && line_begin < manifest.size()) {
+    size_t line_end = manifest.find('\n', line_begin);
+    if (line_end == std::string::npos) {
+      line_end = manifest.size();
+    }
+    const std::string name = manifest.substr(line_begin, line_end - line_begin);
+    line_begin = line_end + 1;
+    if (name.empty()) {
+      continue;
+    }
+    ok = copy_asset(manager, name.c_str(), root + "/" + name, buf, buf_size);
+    drain_looper(app, 0);
+    ok = ok && !app->destroyRequested;
+  }
+  free(buf);
+
+  if (ok) {
+    FILE *file = fopen(stamp_path.c_str(), "wb");
+    ok = (file != nullptr) && (fwrite(manifest.data(), 1, manifest.size(), file) ==
+                               manifest.size());
+    if (file) {
+      ok = (fclose(file) == 0) && ok;
+    }
+  }
+  return ok;
+}
+
+/** \} */
+
+/* Optional developer flags (build_files/android/debug.sh writes them): whitespace separated
+ * player arguments in <external files>/blender_args.txt, reachable over adb without run-as. */
+static void read_extra_args(android_app *app, std::vector<std::string> &r_args)
+{
+  const char *external = app->activity->externalDataPath;
+  std::string text;
+  if (external == nullptr || !read_file(std::string(external) + "/blender_args.txt", text)) {
+    return;
+  }
+  size_t i = 0;
+  while (i < text.size()) {
+    while (i < text.size() && isspace(static_cast<unsigned char>(text[i]))) {
+      i++;
+    }
+    const size_t begin = i;
+    while (i < text.size() && !isspace(static_cast<unsigned char>(text[i]))) {
+      i++;
+    }
+    if (i > begin) {
+      r_args.push_back(text.substr(begin, i - begin));
+    }
+  }
+}
+
+void android_main(android_app *app)
+{
+  redirect_stdio_to_logcat();
+
+  int exit_code = 1;
+  if (wait_for_window(app)) {
+    const std::string root = app->activity->internalDataPath;
+    if (extract_assets(app, root) && wait_for_window(app)) {
+      const std::string resources = root + "/upbge";
+      const std::string user = root + "/user";
+      const std::string tmp = root + "/tmp";
+      mkdir(user.c_str(), 0700);
+      mkdir(tmp.c_str(), 0700);
+      setenv("HOME", root.c_str(), 1);
+      setenv("TMPDIR", tmp.c_str(), 1);
+      setenv("BLENDER_SYSTEM_RESOURCES", resources.c_str(), 1);
+      setenv("BLENDER_USER_RESOURCES", user.c_str(), 1);
+      chdir(root.c_str());
+
+      /* `-w` last: the window is always the full-screen activity surface, and the game file
+       * must be the last argument. */
+      std::vector<std::string> args = {"upbgeplayer"};
+      read_extra_args(app, args);
+      args.push_back("-w");
+      args.push_back(root + "/game.blend");
+      std::vector<char *> argv;
+      for (std::string &arg : args) {
+        LOGI("arg: %s", arg.c_str());
+        argv.push_back(arg.data());
+      }
+      argv.push_back(nullptr);
+
+      GPG_SystemAndroid::setAndroidApp(app);
+      exit_code = GPG_main(int(args.size()), argv.data());
+      GPG_SystemAndroid::setAndroidApp(nullptr);
+    }
+  }
+
+  /* Leave through the activity so Android sees a normal finish, not a crash. */
+  ANativeActivity_finish(app->activity);
+  while (!app->destroyRequested) {
+    drain_looper(app, -1);
+  }
+  flush_stdio_to_logcat();
+  /* Blender's global state cannot be initialized twice in one process, and Android may reuse
+   * this process for the next launch. End it; skip static destructors of a torn-down engine. */
+  _exit(exit_code);
+}
