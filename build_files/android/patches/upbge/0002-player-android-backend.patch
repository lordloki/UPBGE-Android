+/* -------------------------------------------------------------------- */
+/** \name Windows and contexts
+ * \{ */
+
+GHOST_IContext *GPG_SystemAndroid::createOffscreenContext(GHOST_GPUSettings gpu_settings)
+{
+  if (gpu_settings.context_type != GHOST_kDrawingContextTypeVulkan) {
+    return nullptr;
+  }
+  const GHOST_ContextParams context_params_offscreen =
+      GHOST_CONTEXT_PARAMS_FROM_GPU_SETTINGS_OFFSCREEN(gpu_settings);
+  GHOST_Context *context = new GHOST_ContextVK(context_params_offscreen,
+                                               GHOST_kVulkanPlatformHeadless,
+                                               nullptr,
+                                               nullptr,
+                                               nullptr,
+                                               nullptr,
+                                               nullptr,
+                                               1,
+                                               1,
+                                               gpu_settings.preferred_device);
+  if (context->initializeDrawingContext()) {
+    return context;
+  }
+  delete context;
+  return nullptr;
+}
+
+GHOST_TSuccess GPG_SystemAndroid::disposeContext(GHOST_IContext *context)
+{
+  delete context;
+  return GHOST_kSuccess;
+}
+
+GHOST_IWindow *GPG_SystemAndroid::createWindow(const char * /*title*/,
+                                               int32_t /*left*/,
+                                               int32_t /*top*/,
+                                               uint32_t /*width*/,
+                                               uint32_t /*height*/,
+                                               GHOST_TWindowState /*state*/,
+                                               GHOST_GPUSettings gpu_settings,
+                                               const bool /*exclusive*/,
+                                               const bool /*is_dialog*/,
+                                               const GHOST_IWindow * /*parent_window*/)
+{
+  /* One activity, one surface: position, size and state requests do not apply. */
+  if (window_ != nullptr || app_->window == nullptr) {
+    return nullptr;
+  }
+  GPG_WindowAndroid *window = new GPG_WindowAndroid(
+      this, app_->window, GHOST_kWindowStateFullScreen, gpu_settings);
+  if (!window->getValid()) {
+    delete window;
+    return nullptr;
+  }
+  window_ = window;
+  window_manager_->addWindow(window);
+  window_manager_->setActiveWindow(window);
+  pushEvent(std::make_unique<GHOST_Event>(getMilliSeconds(), GHOST_kEventWindowSize, window));
+  return window;
+}
+
+GHOST_IWindow *GPG_SystemAndroid::getWindowUnderCursor(int32_t /*x*/, int32_t /*y*/)
+{
+  return window_;
+}
+
+/** \} */
diff --git a/source/gameengine/GamePlayer/android/GPG_SystemAndroid.h b/source/gameengine/GamePlayer/android/GPG_SystemAndroid.h
new file mode 100644
index 00000000..9c45d9ee
--- /dev/null
+++ b/source/gameengine/GamePlayer/android/GPG_SystemAndroid.h
@@ -0,0 +1,103 @@
+/* SPDX-FileCopyrightText: 2026 UPBGE Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file GPG_SystemAndroid.h
+ *  \ingroup player
+ *
+ * GHOST system for the Android player (NativeActivity + android_native_app_glue).
+ *
+ * Everything runs on the glue's android_main() thread: Blender, Python, the GPU context and
+ * event polling. Exactly one window exists, the activity's ANativeWindow, always full screen.
+ *
+ * Lifecycle v1: losing the window (APP_CMD_TERM_WINDOW: home button, app switch, screen off)
+ * ends the game. The window is marked lost first so no frame touches the dying surface, then
+ * a quit request is queued and the engine leaves its loop on the next event dispatch.
+ */
+
+#pragma once
+
+#include "GHOST_ModifierKeys.hh"
+#include "GHOST_System.hh"
+
+#include <cstdint>
+
+struct android_app;
+struct AInputEvent;
+class GPG_WindowAndroid;
+
+class GPG_SystemAndroid : public GHOST_System {
+ public:
+  /** Must be called by android_main() before #create(). */
+  static void setAndroidApp(android_app *app);
+  static android_app *getAndroidApp();
+
+  /**
+   * Replaces GHOST_ISystem::createSystem() on Android: installs this backend as the GHOST
+   * system singleton. GHOST_ISystem::disposeSystem() deletes it as usual.
+   */
+  static GHOST_TSuccess create();
+
+  ~GPG_SystemAndroid() override;
+
+  bool processEvents(bool waitForEvent) override;
+  bool setConsoleWindowState(GHOST_TConsoleWindowState /*action*/) override
+  {
+    return false;
+  }
+  GHOST_TSuccess getModifierKeys(GHOST_ModifierKeys &keys) const override;
+  GHOST_TSuccess getButtons(GHOST_Buttons &buttons) const override;
+  GHOST_TCapabilityFlag getCapabilities() const override;
+  char *getClipboard(bool /*selection*/) const override
+  {
+    return nullptr;
+  }
+  void putClipboard(const char * /*buffer*/, bool /*selection*/) const override {}
+  uint64_t getMilliSeconds() const override;
+  uint8_t getNumDisplays() const override
+  {
+    return 1;
+  }
+  GHOST_TSuccess getCursorPosition(int32_t &x, int32_t &y) const override;
+  GHOST_TSuccess setCursorPosition(int32_t x, int32_t y) override;
+  void getMainDisplayDimensions(uint32_t &width, uint32_t &height) const override;
+  void getAllDisplayDimensions(uint32_t &width, uint32_t &height) const override;
+  GHOST_IContext *createOffscreenContext(GHOST_GPUSettings gpu_settings) override;
+  GHOST_TSuccess disposeContext(GHOST_IContext *context) override;
+  GHOST_IWindow *createWindow(const char *title,
+                              int32_t left,
+                              int32_t top,
+                              uint32_t width,
+                              uint32_t height,
+                              GHOST_TWindowState state,
+                              GHOST_GPUSettings gpu_settings,
+                              const bool exclusive = false,
+                              const bool is_dialog = false,
+                              const GHOST_IWindow *parent_window = nullptr) override;
+  GHOST_IWindow *getWindowUnderCursor(int32_t /*x*/, int32_t /*y*/) override;
+
+  /** Called by the window destructor, so no event is ever queued for a deleted window. */
+  void windowDestroyed(GPG_WindowAndroid *window);
+
+ private:
+  explicit GPG_SystemAndroid(android_app *app);
+
+  static void onAppCmd(android_app *app, int32_t cmd);
+  static int32_t onInputEvent(android_app *app, AInputEvent *event);
+
+  int32_t handleMotion(const AInputEvent *event);
+  int32_t handleKey(const AInputEvent *event);
+  void pushCursor(int32_t x, int32_t y);
+  void pushButton(bool down);
+
+  android_app *app_;
+  GPG_WindowAndroid *window_ = nullptr;
+  /* CLOCK_MONOTONIC at creation, in ms: GHOST times are relative to it. */
+  uint64_t start_ms_;
+  /* The single tracked touch pointer is the mouse: left button down while touching. */
+  int32_t touch_id_ = -1;
+  int32_t cursor_x_ = 0;
+  int32_t cursor_y_ = 0;
+  bool left_down_ = false;
+  GHOST_ModifierKeys modifiers_;
+};
diff --git a/source/gameengine/GamePlayer/android/GPG_WindowAndroid.cpp b/source/gameengine/GamePlayer/android/GPG_WindowAndroid.cpp
new file mode 100644
index 00000000..c9b6f411
--- /dev/null
+++ b/source/gameengine/GamePlayer/android/GPG_WindowAndroid.cpp
@@ -0,0 +1,111 @@
+/* SPDX-FileCopyrightText: 2026 UPBGE Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file GPG_WindowAndroid.cpp
+ *  \ingroup player
+ */
+
+#include "GPG_WindowAndroid.h"
+#include "GPG_SystemAndroid.h"
+
+#include <android/native_window.h>
+
+/* Last: on Android it defines `Window` as `void *` (the X11 handle slot carries the
+ * ANativeWindow). */
+#include "GHOST_ContextVK.hh"
+
+GPG_WindowAndroid::GPG_WindowAndroid(GPG_SystemAndroid *system,
+                                     ANativeWindow *native_window,
+                                     GHOST_TWindowState state,
+                                     const GHOST_GPUSettings &gpu_settings)
+    : GHOST_Window(uint32_t(ANativeWindow_getWidth(native_window)),
+                   uint32_t(ANativeWindow_getHeight(native_window)),
+                   state,
+                   GHOST_ContextParams GHOST_CONTEXT_PARAMS_FROM_GPU_SETTINGS(gpu_settings),
+                   false),
+      system_(system),
+      native_window_(native_window),
+      preferred_device_(gpu_settings.preferred_device),
+      width_(ANativeWindow_getWidth(native_window)),
+      height_(ANativeWindow_getHeight(native_window))
+{
+  /* Our own reference: the glue drops the activity's one on APP_CMD_TERM_WINDOW, while this
+   * object (and the Vulkan surface) may live a couple of frames longer. */
+  ANativeWindow_acquire(native_window_);
+  valid_ = (setDrawingContextType(gpu_settings.context_type) == GHOST_kSuccess);
+}
+
+GPG_WindowAndroid::~GPG_WindowAndroid()
+{
+  /* Destroy swapchain and surface while the window reference is still held. */
+  setDrawingContextType(GHOST_kDrawingContextTypeNone);
+  ANativeWindow_release(native_window_);
+  system_->windowDestroyed(this);
+}
+
+bool GPG_WindowAndroid::updateSize()
+{
+  if (lost_) {
+    return false;
+  }
+  const int32_t w = ANativeWindow_getWidth(native_window_);
+  const int32_t h = ANativeWindow_getHeight(native_window_);
+  /* Negative values are errors from a dying window: keep the last good size. */
+  if (w <= 0 || h <= 0 || (w == width_ && h == height_)) {
+    return false;
+  }
+  width_ = w;
+  height_ = h;
+  return true;
+}
+
+bool GPG_WindowAndroid::getValid() const
+{
+  /* GHOST_Window falls back to GHOST_ContextNone, so its own check never fails. */
+  return valid_;
+}
+
+void GPG_WindowAndroid::getWindowBounds(GHOST_Rect &bounds) const
+{
+  getClientBounds(bounds);
+}
+
+void GPG_WindowAndroid::getClientBounds(GHOST_Rect &bounds) const
+{
+  bounds.set(0, 0, width_, height_);
+}
+
+GHOST_TSuccess GPG_WindowAndroid::swapBufferAcquire()
+{
+  return lost_ ? GHOST_kSuccess : GHOST_Window::swapBufferAcquire();
+}
+
+GHOST_TSuccess GPG_WindowAndroid::swapBufferRelease()
+{
+  return lost_ ? GHOST_kSuccess : GHOST_Window::swapBufferRelease();
+}
+
+GHOST_Context *GPG_WindowAndroid::newDrawingContext(GHOST_TDrawingContextType type)
+{
+  if (type != GHOST_kDrawingContextTypeVulkan) {
+    /* Android has no desktop OpenGL; GLES is not a Blender GPU backend. */
+    return nullptr;
+  }
+  GHOST_ContextVK *context = new GHOST_ContextVK(want_context_params_,
+                                                 GHOST_kVulkanPlatformAndroid,
+                                                 static_cast<void *>(native_window_),
+                                                 nullptr,
+                                                 nullptr,
+                                                 nullptr,
+                                                 nullptr,
+                                                 1,
+                                                 1,
+                                                 preferred_device_,
+                                                 &hdr_info_);
+  if (context->initializeDrawingContext()) {
+    return context;
+  }
+  delete context;
+  return nullptr;
+}
