# source/gameengine/blenderplayer/CMakeLists.txt (Android fragment)
#
# On Android, the blenderplayer target is built as a SHARED library that
# android_main_wrapper.cc links against, not an executable. The glue's
# entry point is `android_main`, defined in the wrapper.

if(WITH_ANDROID)
  add_library(blenderplayer SHARED
    android_main_wrapper.cc
    ${UPBGE_PLAYER_SRCS}      # the original main.cc with main() renamed to player_main()
  )
  target_link_libraries(blenderplayer PUBLIC
    bf_intern_ghost
    bf_blenkernel
    bf_blenlib
    bf_gpu
    bf_windowmanager
    bf_intern_audaspace
    ge_bge_rasterizer
    ge_bge_logic
    ge_bge_physics
    ${PYTHON_LIBRARIES}
    android
    log
    ${VULKAN_LIBRARIES}
  )
  # Mark the entrypoint exported
  set_target_properties(blenderplayer PROPERTIES
    PREFIX "lib"
    OUTPUT_NAME "upbgeplayer"   # → libupbgeplayer.so, loaded by native glue
  )
else()
  # Original (desktop) executable build path stays untouched here.
  add_executable(blenderplayer ${UPBGE_PLAYER_SRCS})
  target_link_libraries(blenderplayer PRIVATE
    bf_intern_ghost bf_blenkernel bf_blenlib bf_gpu
    bf_windowmanager bf_intern_audaspace
    ge_bge_rasterizer ge_bge_logic ge_bge_physics
    ${PYTHON_LIBRARIES}
  )
endif()
