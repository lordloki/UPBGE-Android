build_files/android/patches/0001-GHOST-Android-minimal-backend.patch

Minimal GHOST Android backend for UPBGE master.

This patch adds the minimum set of GHOST_SystemAndroid / GHOST_WindowAndroid /
GHOST_EventAndroid files needed to boot a Vulkan window from an ANativeWindow
provided by the Android native app glue. It does NOT include Wanderson's
touch/stylus/soft-keyboard work — input is mapped 1:1 to mouse buttons and
motion events, which is enough for the blenderplayer runtime.

The implementation files (GHOST_SystemAndroid.cc etc.) ship alongside this
patch in build_files/android/patches/ghost_android/ and are COPIED into the
UPBGE tree by scripts/apply_patches.sh. This diff only updates the CMake
wiring so the build system knows how to compile them.

Apply with:
    patch -d $UPBGE_SOURCE -p1 < 0001-GHOST-Android-minimal-backend.patch

diff --git a/intern/ghost/CMakeLists.txt b/intern/ghost/CMakeLists.txt
--- a/intern/ghost/CMakeLists.txt
+++ b/intern/ghost/CMakeLists.txt
@@ -130,6 +130,21 @@ if(WITH_GHOST_WAYLAND)
   )
 endif()

+if(WITH_GHOST_ANDROID)
+  list(APPEND SRC
+    intern/GHOST_AndroidMain.cc
+    intern/GHOST_SystemAndroid.cc
+    intern/GHOST_WindowAndroid.cc
+  )
+  list(APPEND INC_SYS
+    ${ANDROID_NDK}/sources/android/native_app_glue
+  )
+  target_link_libraries(bf_intern_ghost PUBLIC
+    android
+    log
+  )
+endif()
+
 if(WITH_INPUT_NDOF)
   list(APPEND SRC
     intern/GHOST_NDOFManager.cc
diff --git a/source/blender/gpu/CMakeLists.txt b/source/blender/gpu/CMakeLists.txt
--- a/source/blender/gpu/CMakeLists.txt
+++ b/source/blender/gpu/CMakeLists.txt
@@ -700,6 +700,10 @@ if(WITH_GPU_VULKAN)
     intern/vulkan/vk_descriptor_set_layout.cc
   )

+  if(WITH_GHOST_ANDROID)
+    list(APPEND SRC intern/vulkan/vk_surface_android.cc)
+  endif()
+
   target_link_libraries(bf_gpu PRIVATE
     ${VULKAN_LIBRARIES}
   )
