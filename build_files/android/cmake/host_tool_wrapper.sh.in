#!/bin/sh
# Generated by upbge_android_project.cmake: runs the host @UPBGE_TOOL@.
# Blender's precompiled .so carry RUNPATH=$ORIGIN, which only works once they
# share one directory (the install layout). In lib/linux_x64 each package has
# its own lib/, and a RUNPATH disables the executable's RPATH for the library's
# own dependencies (OpenImageIO -> OpenEXR). LD_LIBRARY_PATH is searched before
# RUNPATH, as Blender's PLATFORM_ENV_BUILD does in the host tree.
dirs='@UPBGE_HOST_LIBRARY_PATH@'
if [ -n "$dirs" ]; then
  LD_LIBRARY_PATH="$dirs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export LD_LIBRARY_PATH
fi
exec '@UPBGE_HOST_TOOL@' "$@"
