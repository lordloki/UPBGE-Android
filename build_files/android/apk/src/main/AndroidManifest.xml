<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml for the UPBGE player bundle.

  The future Blender add-on takes this template, replaces assets/game.blend
  with the real game, signs the APK, and ships it.

  Package name: org.upbge.player  — the add-on MUST keep the package name or
  change it consistently here AND in MainActivity.java (the JNI call resolves
  org.upbge.player.MainActivity).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.upbge.player"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- MinSdk 31 = Android 12; matches the NDK platform used to cross-compile. -->
    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="34" />

    <!-- UPBGE needs a GPU. Vulkan is mandatory on Android 12+. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version"
                  android:version="4202496" android:required="true" />
    <!-- Touch screen (a game needs input). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!-- The native library is arm64-v8a or armeabi-v7a; the add-on filters
         this rule to the architecture it actually packaged. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:hasCode="true"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- The activity is the surface that hosts ANativeWindow → Vulkan →
             UPBGE. android_main() in the glue reads the launch intent's
             extras to know which .blend to load (defaults to assets/game.blend). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Allow the future add-on to deep-link a .blend file:
                 adb shell am start -n org.upbge.player/.MainActivity \
                     -d "file:///sdcard/mygame.blend" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-blender" />
            </intent-filter>
        </activity>
    </application>
</manifest>
