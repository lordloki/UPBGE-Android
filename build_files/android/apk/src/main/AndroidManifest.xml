<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml for the UPBGE player.

  No Java/Kotlin code: android.app.NativeActivity loads lib<android.app.lib_name>.so
  (libupbgeplayer.so), whose android_native_app_glue runs android_main(). The game
  is assets/game.blend; the add-on replaces it and may rename the package.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.upbge.player"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- MinSdk 31 = Android 12; matches the NDK platform used to cross-compile. -->
    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="34" />

    <!-- Vulkan 1.2 (0x402000): timeline semaphores are core there. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version"
                  android:version="4202496" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:hasCode="false"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- configChanges: without them a rotation or keyboard change recreates the
             activity, which destroys the window and (lifecycle v1) ends the game.
             sensorLandscape flips between the two landscape orientations; the
             Vulkan backend re-creates its pre-rotated swapchain for that. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false">
            <meta-data android:name="android.app.lib_name" android:value="upbgeplayer" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
